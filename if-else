public class Demo {
    public static void main(String[] args) {

        int n = 5;

        if (n % 2 == 0) {
            System.out.println("Even");
        } else {
            System.out.println("Odd");
        }

        for (int i = 1; i <= 5; i++) {
            System.out.println(i);
        }
    }
}
