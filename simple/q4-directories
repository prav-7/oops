import java.io.File;

class Main {
    static void showFiles(File f) {
        File[] files = f.listFiles();

        if (files == null)
            return;

        for (File x : files) {
            if (x.isFile())
                System.out.println(x);
            else
                showFiles(x);
        }
    }

    public static void main(String[] args) {
        File f = new File("C:\\Java");
        showFiles(f);
    }
}
