import java.util.*;

class Demo {
    public static void main(String[] args) {
        Random r = new Random();

        for (int i = 1; i <= 5; i++) {
            int n = r.nextInt(10);

            System.out.println("Number: " + n);

            if (n % 2 == 0)
                System.out.println("Square: " + (n * n));
            else
                System.out.println("Cube: " + (n * n * n));

            try {
                Thread.sleep(1000);
            } catch (Exception e) {}
        }
    }
}
